<%- include("partials/header") %>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card p-3">Total: <%= total %></div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">Pending: <%= pending %></div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">Completed: <%= completed %></div>
    </div>
</div>

<table class="table table-bordered">
    <tr>
        <th>ID</th><th>Title</th><th>Priority</th><th>Status</th><th>Actions</th>
    </tr>

    <% tasks.forEach(task => { %>
        <tr>
            <td><%= task.id %></td>
            <td><%= task.title %></td>
            <td><%= task.priority %></td>
            <td>
                <span class="badge bg-info"><%= task.status %></span>
            </td>
            <td>
                <a href="/edit/<%= task.id %>" class="btn btn-warning btn-sm">Edit</a>
                <a href="/delete/<%= task.id %>" class="btn btn-danger btn-sm">Delete</a>
                <a href="/status/<%= task.id %>" class="btn btn-primary btn-sm">Update</a>
            </td>
        </tr>
    <% }) %>
</table>

<%- include("partials/footer") %>